# ============================================================
# GeoShield AI Enterprise
# Environment Configuration Template
# ============================================================
#
# COPY THIS FILE TO .env
#
# NEVER COMMIT .env TO GIT.
# NEVER PLACE REAL PASSWORDS, TOKENS, OR API KEYS IN THIS FILE.
# ============================================================

GEOSHIELD_ENV=development

# ------------------------------------------------------------
# Copernicus Data Space Ecosystem
# ------------------------------------------------------------

CDSE_USERNAME=your_copernicus_email
CDSE_PASSWORD=your_copernicus_password

CDSE_CLIENT_ID=cdse-public

CDSE_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token

CDSE_CATALOG_URL=https://catalogue.dataspace.copernicus.eu/odata/v1/Products

# ------------------------------------------------------------
# Planet
# ------------------------------------------------------------

PLANET_API_KEY=your_planet_api_key
PLANET_CLIENT_ID=your_planet_client_id
PLANET_CLIENT_SECRET=your_planet_client_secret

# ------------------------------------------------------------
# Runtime
# ------------------------------------------------------------

GEOSHIELD_HTTP_TIMEOUT=60