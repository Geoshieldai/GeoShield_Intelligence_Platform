<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>GeoShield OS</title>

<link rel="stylesheet" href="/static/style.css">

<link rel="stylesheet"
href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>

<link rel="stylesheet"
href="https://unpkg.com/leaflet-control-geocoder/dist/Control.Geocoder.css"/>

</head>

<body>
<div class="app">

    <!-- LEFT SIDEBAR -->

    <aside class="sidebar">

        <div class="logo">

            <h2>🛡 GEOSHIELD</h2>

            <span>Geospatial Intelligence Platform</span>

        </div>

        <nav>

            <a class="active">🏠 Dashboard</a>

            <a>🗺 Live Map</a>

            <a>📈 Analytics</a>

            <a>🚨 Alerts</a>

            <a>📄 Reports</a>

            <hr>

            <a>🌊 Flood Engine</a>

            <a>🔥 Fire Engine</a>

            <a>🌍 Earthquake Engine</a>

            <a>🌱 Agriculture</a>

            <hr>

            <a>⚙ Settings</a>

        </nav>

    </aside>



    <!-- RIGHT SIDE -->

    <main class="main-content">

        <!-- TOP BAR -->

        <header class="topbar">

            <div class="title">

                <h1>GeoShield OS</h1>

                <span>Real-Time Disaster Intelligence</span>

            </div>

            <div class="top-actions">

                <select id="incidentType">

    <option value="Fire">🔥 Fire</option>

    <option value="Flood">🌊 Flood</option>

    <option value="Earthquake">🌍 Earthquake</option>

    <option value="Drought">🌾 Drought</option>

    <option value="Disease">🦠 Disease</option>

</select>

                <button id="locateBtn">📍 Locate</button>

                <button>🛰 Layers</button>

                <button>🚨 Alerts</button>

                <button>⚙ Settings</button>

            </div>

        </header>



        <!-- CENTER -->

        <section class="workspace">

            <!-- MAP -->

            <section class="map-section">

                <div id="map"></div>

            </section>



            <!-- RIGHT INFO -->

            <aside class="info-panel">

                <div class="panel-card">

                    <h3>🟢 System Status</h3>

                    <p id="health">Loading...</p>

                </div>

                <div class="panel-card">

                    <h3>🌤 Weather</h3>

                    <p id="weather">Loading...</p>

                </div>

                <div class="panel-card">

                    <h3>🚨 Active Alerts</h3>

                    <h1 id="events">0</h1>

                </div>

                <div class="panel-card">

                    <h3>🤖 AI Risk</h3>

                    <h1 id="aiScore">0%</h1>

                </div>

                <div class="panel-card">

<h3>🕒 Last Update</h3>

<p id="lastUpdate">Loading...</p>

</div>

                <div class="panel-card">

                    <h3>🔥 Fire Risk</h3>

                    <h1 id="fireRisk">LOW</h1>

                </div>

            </aside>

        </section>



        <!-- BOTTOM -->
<section class="bottom-dashboard">

    <div class="bottom-card">
        <h3>NDVI</h3>
        <h2 id="ndviCard">--</h2>
    </div>

    <div class="bottom-card">
        <h3>Rainfall</h3>
        <h2 id="rainfallCard">--</h2>
    </div>

    <div class="bottom-card">
        <h3>Temperature</h3>
        <h2 id="temperatureCard">--</h2>
    </div>

    <div class="bottom-card">
        <h3>Flood Risk</h3>
        <h2 id="floodRiskCard">--</h2>
    </div>

    <div class="bottom-card">
        <h3>Fire Risk</h3>
        <h2 id="fireRiskCard">--</h2>
    </div>

    <div class="bottom-card">
        <h3>Population</h3>
        <h2 id="populationCard">--</h2>
    </div>

</section>

    </main>

</div>

<!-- Leaflet -->

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script src="https://unpkg.com/leaflet-control-geocoder/dist/Control.Geocoder.js"></script>


<script src="/static/config.js"></script>
<script src="/static/utils.js"></script>
<script src="/static/map.js"></script>
<script src="/static/controls.js"></script>
<script src="/static/dashboard.js"></script>
<script src="/static/infrastructure.js"></script>
<script src="/static/counties.js"></script>
<script src="/static/fire.js"></script>
<script src="/static/legend.js"></script>
<script src="/static/app.js"></script>

</body>
</html>