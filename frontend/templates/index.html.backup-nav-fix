<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>GeoShield OS</title>

<link rel="stylesheet" href="/static/style.css">
<link rel="stylesheet" href="/static/sentinel2.css">
<link rel="stylesheet" href="/static/satellite-center.css">
<link rel="stylesheet" href="/static/workspace.css"><link rel="stylesheet" href="/static/workspace-nav.css">
<link rel="stylesheet" href="/static/satellites.css">

<link rel="stylesheet"
href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>

<link rel="stylesheet"
href="https://unpkg.com/leaflet-control-geocoder/dist/Control.Geocoder.css"/>

</head>

<body>
<div class="app">

    <!-- LEFT SIDEBAR -->

    <aside class="sidebar">

        <div class="logo">

            <h2>GEOSHIELD</h2>

            <span>Geospatial Intelligence Platform</span>

        </div>

        <nav>

    <a class="active">&#x1F3E0; Dashboard</a>

    <a>&#x1F5FA;&#xFE0F; Live Map</a>

    <a>&#x1F4C8; Analytics</a>

    <a>&#x1F6A8; Alerts</a>

    <a>&#x1F4C4; Reports</a>

    <hr>

    <a>&#x1F30A; Flood Engine</a>

    <a>&#x1F525; Fire Engine</a>

    <a>&#x1F30D; Earthquake Engine</a>

    <a>&#x1F33F; Agriculture</a>

    <hr>

    <a>&#x2699;&#xFE0F; Settings</a>

</nav>

    </aside>



    <!-- RIGHT SIDE -->

    <main class="main-content">

        <!-- TOP BAR -->

        <header class="topbar">

            <div class="title">

                <h1>GeoShield OS</h1>

                <span>Real-Time Disaster Intelligence</span>

            </div>

            <div class="top-actions">

                <select id="incidentType">

    <option value="Fire">&#x1F525; Fire</option>

    <option value="Flood">&#x1F30A; Flood</option>

    <option value="Earthquake">&#x1F30D; Earthquake</option>

    <option value="Drought">&#x1F33E; Drought</option>

    <option value="Disease">&#x1F9A0; Disease</option>

</select>

                <button id="locateBtn">&#128205; Locate</button>

                <button>&#x1F6F0;&#xFE0F; Layers</button>

                <button>&#x1F6A8; Alerts</button>

                <button>&#x2699;&#xFE0F; Settings</button>

            </div>

        </header>



        <!-- CENTER -->

        <section class="workspace">

            <!-- MAP -->

            <section class="map-section">

                <div id="map"></div>

            </section>



            <!-- RIGHT INFO -->

            <aside class="info-panel">

                <div class="panel-card">

                    <h3>ðŸŸ¢ System Status</h3>

                    <p id="health">Loading...</p>

                </div>

                <div class="panel-card">

                    <h3>ðŸŒ¤ Weather</h3>

                    <p id="weather">Loading...</p>

                </div>

                <div class="panel-card">

                    <h3>ðŸš¨ Active Alerts</h3>

                    <h1 id="events">0</h1>

                </div>

                <div class="panel-card">

                    <h3>ðŸ¤– AI Risk</h3>

                    <h1 id="aiScore">0%</h1>

                </div>

                <div class="panel-card">

<h3>ðŸ•’ Last Update</h3>

<p id="lastUpdate">Loading...</p>

</div>

                <div class="panel-card">

                    <h3>ðŸ”¥ Fire Risk</h3>

                    <h1 id="fireRisk">LOW</h1>

                </div>

            </aside>

        </section>



        <!-- BOTTOM -->
<section class="bottom-dashboard">

    <div class="bottom-card">
        <h3>NDVI</h3>
        <h2 id="ndviCard">--</h2>
    </div>

    <div class="bottom-card">
        <h3>Rainfall</h3>
        <h2 id="rainfallCard">--</h2>
    </div>

    <div class="bottom-card">
        <h3>Temperature</h3>
        <h2 id="temperatureCard">--</h2>
    </div>

    <div class="bottom-card">
        <h3>Flood Risk</h3>
        <h2 id="floodRiskCard">--</h2>
    </div>

    <div class="bottom-card">
        <h3>Fire Risk</h3>
        <h2 id="fireRiskCard">--</h2>
    </div>

    <div class="bottom-card">
        <h3>Population</h3>
        <h2 id="populationCard">--</h2>
    </div>

</section>

    

<!-- =========================================================
     SATELLITE DATA CENTER
     ========================================================= -->

<section
    id="satelliteDataCenter"
    class="satellite-data-center"
>

    <div class="satellite-center-header">

        <div>

            <h2>?? Satellite Intelligence</h2>

            <p>
                GeoShield Earth-observation data sources
                and intelligence products.
            </p>

        </div>

        <span class="satellite-center-badge">
            MULTI-SOURCE
        </span>

    </div>


    <div
        id="satelliteRegistry"
        class="satellite-registry"
    >

        <div class="satellite-loading">
            Loading satellite systems...
        </div>

    </div>

</section>


<!-- =========================================================
     GEOSHIELD SATELLITE INTELLIGENCE CENTER
     ========================================================= -->

<section id="satelliteCenter" class="satellite-center">

    <div class="satellite-center-header">

        <div>
            <h2>&#x1F6F0;&#xFE0F; Satellite Intelligence</h2>

            <p>
                Connected Earth-observation data sources powering
                GeoShield geospatial intelligence.
            </p>
        </div>

        <div
            id="satelliteSystemStatus"
            class="satellite-system-status">
            Connecting...
        </div>

    </div>

    <div
        id="satelliteGrid"
        class="satellite-grid">

        <div class="satellite-loading">
            Loading satellite services...
        </div>

    </div>

</section>
<!-- =========================================================
     SENTINEL-2 IMAGERY PRODUCT
     ========================================================= -->

<section id="sentinel2Product" class="sentinel2-product">

    <div class="sentinel2-header">

        <div>
            <h2>🛰 Sentinel-2 Imagery</h2>
            <p>
                Copernicus Sentinel-2 Earth observation imagery
                for geospatial intelligence and environmental analysis.
            </p>
        </div>

        <span id="sentinel2Status" class="sentinel2-status">
            Ready
        </span>

    </div>

    <div class="sentinel2-controls">

        <div class="sentinel2-field">

            <label for="sentinel2StartDate">
                Start Date
            </label>

            <input
                type="date"
                id="sentinel2StartDate"
            >

        </div>

        <div class="sentinel2-field">

            <label for="sentinel2EndDate">
                End Date
            </label>

            <input
                type="date"
                id="sentinel2EndDate"
            >

        </div>

        <div class="sentinel2-field">

            <label for="sentinel2Cloud">
                Maximum Cloud Cover
            </label>

            <input
                type="number"
                id="sentinel2Cloud"
                min="0"
                max="100"
                step="1"
                value="30"
            >

        </div>

        <button
            type="button"
            id="sentinel2SearchBtn"
            class="sentinel2-search-btn"
        >
            Search Imagery
        </button>

    </div>

    <div
        id="sentinel2Results"
        class="sentinel2-results"
    >

        <div class="sentinel2-empty">

            <strong>No Sentinel-2 scene selected</strong>

            <span>
                Search for available imagery to begin.
            </span>

        </div>

    </div>

</section>

</main>

</div>

<!-- Leaflet -->

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script src="https://unpkg.com/leaflet-control-geocoder/dist/Control.Geocoder.js"></script>


<script src="/static/config.js"></script>
<script src="/static/utils.js"></script>
<script src="/static/map.js"></script>
<script src="/static/controls.js"></script>
<script src="/static/dashboard.js"></script>
<script src="/static/infrastructure.js"></script>
<script src="/static/counties.js"></script>
<script src="/static/fire.js"></script>
<script src="/static/legend.js"></script>
<script src="/static/satellites.js"></script>
<script src="/static/sentinel2.js"></script>
<script src="/static/workspace-nav.js"></script><script src="/static/app.js"></script>

<!-- =========================================================
     GEOSHIELD WORKSPACE NAVIGATION
     MAIN MAP <-> INTELLIGENCE CENTER
     ========================================================= -->
<div
    id="workspaceNavigator"
    class="workspace-nav"
    aria-label="GeoShield workspace navigation"
>
    <button
        type="button"
        id="workspaceUpBtn"
        class="workspace-nav-arrow"
        aria-label="Go to Main Map"
        title="Go to Main Map"
    >
        ?
    </button>
    <div class="workspace-nav-divider"></div>
    <div
        id="workspaceCurrent"
        class="workspace-nav-center"
    >
        MAP
    </div>
    <div class="workspace-nav-divider"></div>
    <button
        type="button"
        id="workspaceDownBtn"
        class="workspace-nav-arrow"
        aria-label="Go to Intelligence Center"
        title="Go to Intelligence Center"
    >
        ?
    </button>
    <div class="workspace-nav-tooltip">
        ? Main Map<br>
        ? Intelligence Center
    </div>
</div>
<!-- GEOSHIELD WORKSPACE NAVIGATION START -->

<div
    id="workspaceNavigator"
    class="workspace-nav"
    aria-label="GeoShield workspace navigation">

    <button
        type="button"
        class="workspace-nav-arrow"
        id="workspaceMapBtn"
        title="Go to Main Map"
        aria-label="Go to Main Map">
        &#8593;
    </button>

    <button
        type="button"
        class="workspace-nav-label"
        id="workspaceIntelligenceBtn"
        title="Go to Intelligence Center"
        aria-label="Go to Intelligence Center">
        &#128752;&#65039; Intelligence
    </button>

    <button
        type="button"
        class="workspace-nav-arrow"
        id="workspaceIntelligenceArrow"
        title="Go to Intelligence Center"
        aria-label="Go to Intelligence Center">
        &#8595;
    </button>

</div>

<!-- GEOSHIELD WORKSPACE NAVIGATION END -->

</body>
</html>














