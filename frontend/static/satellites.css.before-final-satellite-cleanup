/*
============================================================
 GeoShield OS
 Satellite Intelligence — Card Presentation
============================================================
*/

.satellite-intelligence {
    margin-top: 28px;
    padding: 24px;
    background:
        linear-gradient(
            145deg,
            rgba(15, 23, 42, 0.98),
            rgba(17, 24, 39, 0.96)
        );
    border-radius: 16px;
    border: 1px solid rgba(148, 163, 184, 0.15);
}

.satellite-intelligence-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 22px;
}

.satellite-intelligence-header h2 {
    margin: 0;
    font-size: 22px;
}

.satellite-intelligence-header p {
    margin-top: 7px;
    color: #94a3b8;
}

/* ============================================================
   SATELLITE CARD
   ============================================================ */

.satellite-card {
    padding: 18px;
    border-radius: 14px;

    background:
        rgba(30, 41, 59, 0.80);

    border:
        1px solid rgba(148, 163, 184, 0.15);

    box-sizing: border-box;

    transition:
        transform 0.18s ease,
        border-color 0.18s ease,
        box-shadow 0.18s ease;
}

.satellite-card:hover {
    transform: translateY(-2px);

    border-color:
        rgba(96, 165, 250, 0.45);

    box-shadow:
        0 8px 25px rgba(0, 0, 0, 0.18);
}

.satellite-card.is-active,
.satellite-card.active {
    border-color:
        rgba(34, 197, 94, 0.35);
}

.satellite-card.planned {
    opacity: 0.78;
}

/* ============================================================
   CARD CONTENT
   ============================================================ */

.satellite-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
}

.satellite-title {
    display: flex;
    align-items: center;
    gap: 12px;
}

.satellite-icon {
    width: 44px;
    height: 44px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 12px;

    background:
        rgba(59, 130, 246, 0.12);

    font-size: 23px;
}

.satellite-name,
.satellite-title h3 {
    margin: 0;
    font-size: 17px;
}

.satellite-provider {
    display: block;
    margin-top: 4px;
    color: #94a3b8;
    font-size: 12px;
}

.satellite-status {
    padding: 5px 9px;
    border-radius: 999px;

    font-size: 10px;
    font-weight: 800;

    text-transform: uppercase;
    letter-spacing: 0.6px;
}

.satellite-status.active {
    background:
        rgba(34, 197, 94, 0.12);

    color: #86efac;
}

.satellite-status.planned {
    background:
        rgba(245, 158, 11, 0.12);

    color: #fcd34d;
}

.satellite-category {
    margin-top: 14px;

    color: #60a5fa;

    font-size: 12px;
    font-weight: 600;

    text-transform: uppercase;
    letter-spacing: 0.6px;
}

.satellite-description {
    margin: 10px 0 14px;

    color: #cbd5e1;

    font-size: 13px;
    line-height: 1.5;
}

.satellite-capabilities {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
}

.satellite-capability {
    padding: 5px 8px;

    border-radius: 7px;

    background:
        rgba(148, 163, 184, 0.09);

    color: #cbd5e1;

    font-size: 11px;
}

.satellite-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;

    margin-top: 18px;
    padding-top: 13px;

    border-top:
        1px solid rgba(148, 163, 184, 0.1);

    color: #64748b;
    font-size: 11px;
}

.satellite-open-btn {
    border: 0;
    border-radius: 8px;

    padding: 7px 13px;

    cursor: pointer;

    background: #2563eb;
    color: white;

    font-weight: 600;
}

.satellite-open-btn:hover {
    background: #1d4ed8;
}

.satellite-coming-soon {
    color: #fbbf24;
}

.satellite-empty,
.satellite-error {
    padding: 25px;

    border-radius: 12px;

    background:
        rgba(30, 41, 59, 0.6);

    color: #94a3b8;
}

.satellite-error strong {
    display: block;
    margin-bottom: 6px;
    color: #f87171;
}

/* ============================================================
   IMPORTANT:
   Horizontal layout is controlled by style.css.
   This file controls presentation only.
============================================================ */
