/*
============================================================
GeoShield AI Enterprise
Satellite Intelligence Center
Horizontal Satellite Navigator
============================================================

ARCHITECTURE:

    Satellite Intelligence
            |
            v
    Horizontal Satellite Track
            |
            +---- Sentinel-2
            +---- Sentinel-1
            +---- VIIRS
            +---- GPM
            +---- ERA5

IMPORTANT:

- No window scrolling
- No scrollIntoView()
- No IntersectionObserver
- No anchor navigation
- No workspace switching
- Horizontal navigation uses CSS transform
- Main Map / Intelligence navigation remains independent
============================================================
*/

(function () {

    "use strict";


    const API_URL = "/satellites";


    const ICONS = {

        sentinel2: "\uD83D\uDEF0\uFE0F",

        sentinel1: "\uD83D\uDCE1",

        viirs: "\uD83D\uDD25",

        gpm: "\uD83C\uDF27\uFE0F",

        era5: "\uD83C\uDF0D"

    };
    /*
    ============================================================
    HTML ESCAPING
    ============================================================
    */

    function escapeHtml(value) {

        if (
            value === null ||
            value === undefined
        ) {

            return "";

        }


        return String(value)

            .replace(/&/g, "&amp;")

            .replace(/</g, "&lt;")

            .replace(/>/g, "&gt;")

            .replace(/"/g, "&quot;")

            .replace(/'/g, "&#039;");

    }


    /*
    ============================================================
    CAPABILITY LIST
    ============================================================
    */

    function createCapabilityList(capabilities) {

        if (!Array.isArray(capabilities)) {

            return "";

        }


        return capabilities

            .map(function (capability) {

                return `
                    <span class="satellite-capability">
                        ${escapeHtml(capability)}
                    </span>
                `;

            })

            .join("");

    }


    /*
    ============================================================
    SATELLITE CARD
    ============================================================
    */

    function createSatelliteCard(satellite) {

        const id =
            escapeHtml(satellite.id);


        const name =
            escapeHtml(satellite.name);


        const provider =
            escapeHtml(satellite.provider);


        const category =
            escapeHtml(satellite.category);


        const description =
            escapeHtml(satellite.description);


        const status =
            satellite.status === "active"
                ? "active"
                : "planned";


        const icon =
            ICONS[satellite.id] ||
            "\uD83D\uDEF0\uFE0F";


        let button = "";


        if (status === "active") {

            button = `

                <button
                    type="button"
                    class="satellite-open-btn"
                    data-satellite-id="${id}">

                    Open Satellite

                </button>

            `;

        }

        else {

            button = `

                <button
                    type="button"
                    class="satellite-open-btn planned"
                    disabled>

                    Coming Soon

                </button>

            `;

        }


        return `

            <article
                class="satellite-card ${status}"
                data-satellite="${id}">

                <div class="satellite-card-header">

                    <div>

                        <div class="satellite-icon">

                            ${icon}

                        </div>


                        <h3 class="satellite-name">

                            ${name}

                        </h3>


                        <div class="satellite-provider">

                            ${provider}

                        </div>

                    </div>


                    <span
                        class="satellite-status ${status}">

                        ${escapeHtml(
                            satellite.status
                        )}

                    </span>

                </div>


                <div class="satellite-category">

                    ${category}

                </div>


                <div class="satellite-description">

                    ${description}

                </div>


                <div class="satellite-capabilities">

                    ${createCapabilityList(
                        satellite.capabilities
                    )}

                </div>


                ${button}

            </article>

        `;

    }



    /*
    ============================================================
    SATELLITE BUTTONS
    ============================================================
    */

    function bindSatelliteButtons() {

        const buttons =
            document.querySelectorAll(
                ".satellite-open-btn[data-satellite-id]"
            );


        buttons.forEach(function (button) {

            if (
                button.dataset
                    .geoshieldBound === "true"
            ) {

                return;

            }


            button.dataset
                .geoshieldBound = "true";


            button.addEventListener(
                "click",
                function () {

                    const id =
                        this.dataset.satelliteId;


                    openSatellite(id);

                }
            );

        });

    }


    /*
    ============================================================
    OPEN SATELLITE
    ============================================================
    */

    function openSatellite(id) {

        console.log(
            "GeoShield satellite selected:",
            id
        );


        /*
        ========================================================
        STATIC SATELLITE ACTIVATION

        Satellite selection MUST NOT:

        - scroll the page
        - scroll .main-content
        - change workspace
        - use anchors
        - use scrollIntoView()
        - use window.scrollTo()
        - use IntersectionObserver()

        The horizontal satellite navigator is independent
        from document/workspace scrolling.
        ========================================================
        */


        if (id === "sentinel2") {

            const section =
                document.getElementById(
                    "sentinel2Product"
                );


            if (!section) {

                console.warn(
                    "Sentinel-2 product section not found."
                );

                return;

            }


            section.classList.add(
                "satellite-product-active"
            );


            window.setTimeout(
                function () {

                    section.classList.remove(
                        "satellite-product-active"
                    );

                },
                350
            );


            return;

        }


        console.log(
            "Satellite interface not yet activated:",
            id
        );

    }


    /*
    ============================================================
    RENDER SATELLITES
    ============================================================
    */

    function renderSatellites(payload) {

        const grid =
            document.getElementById(
                "satelliteGrid"
            );


        const systemStatus =
            document.getElementById(
                "satelliteSystemStatus"
            );


        if (!grid) {

            console.warn(
                "GeoShield: satelliteGrid not found."
            );

            return;

        }


        if (
            !payload ||
            !Array.isArray(
                payload.satellites
            )
        ) {

            grid.innerHTML = `

                <div class="satellite-error">

                    Satellite registry returned
                    invalid data.

                </div>

            `;

            return;

        }


        grid.innerHTML =
            payload.satellites
                .map(
                    createSatelliteCard
                )
                .join("");


        const satellites =
            payload.satellites;


        const total =
            satellites.length;


        const active =
            satellites.filter(
                function (satellite) {

                    return (
                        satellite.status ===
                        "active"
                    );

                }
            ).length;


        if (systemStatus) {

            systemStatus.textContent =
                `${active} active / ${total} registered`;

        }


        bindSatelliteButtons();

        /* Horizontal navigator handled by satellite-horizontal-navigator.js */

        if (window.GeoShieldSatelliteNavigator && window.GeoShieldSatelliteNavigator.refresh) {

            window.GeoShieldSatelliteNavigator.refresh();

        }

    }


    /*
    ============================================================
    LOAD SATELLITES
    ============================================================
    */

    async function loadSatellites() {

        const grid =
            document.getElementById(
                "satelliteGrid"
            );


        if (!grid) {

            return;

        }


        try {

            grid.innerHTML = `

                <div class="satellite-loading">

                    Connecting to satellite registry...

                </div>

            `;


            const response =
                await fetch(
                    API_URL,
                    {
                        method: "GET",

                        headers: {
                            "Accept":
                                "application/json"
                        }
                    }
                );


            if (!response.ok) {

                throw new Error(
                    `Satellite registry HTTP ${response.status}`
                );

            }


            const data =
                await response.json();


            renderSatellites(data);

        }

        catch (error) {

            console.error(
                "GeoShield satellite registry error:",
                error
            );


            grid.innerHTML = `

                <div class="satellite-error">

                    Unable to connect to the
                    satellite registry.

                </div>

            `;

        }

    }


    /*
    ============================================================
    INITIALIZATION
    ============================================================
    */

    function initialize() {

        /* Horizontal navigator handled by satellite-horizontal-navigator.js */

        loadSatellites();


        console.log(
            "GeoShield Satellite Intelligence initialized."
        );


        console.log(
            "Horizontal satellite navigation: ENABLED"
        );


        console.log(
            "Document scrolling: DISABLED"
        );

    }


    /*
    ============================================================
    PUBLIC API
    ============================================================
    */

    window.GeoShieldSatellites = {

        initialize:
            initialize,

        load:
            loadSatellites,

        moveLeft:
            function () {

            },

        moveRight:
            function () {

            }

    };


    /*
    ============================================================
    START
    ============================================================
    */

    if (
        document.readyState ===
        "loading"
    ) {

        document.addEventListener(
            "DOMContentLoaded",
            initialize,
            {
                once: true
            }
        );

    }

    else {

        initialize();

    }


})();






