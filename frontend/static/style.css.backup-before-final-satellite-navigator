/* ============================================================
   GEOSHIELD GLOBAL SATELLITE INTELLIGENCE CANVAS
   ============================================================ */

#satelliteIntelligenceViewport {

    width: 100% !important;

    max-width: 100% !important;

    overflow-x: auto !important;

    overflow-y: hidden !important;

    position: relative !important;

    box-sizing: border-box !important;

    scrollbar-width: none;

    overscroll-behavior-x: contain;

}


#satelliteIntelligenceViewport::-webkit-scrollbar {

    display: none;

}


#satelliteIntelligenceCanvas {

    width: max-content !important;

    min-width: 100% !important;

    max-width: none !important;

    display: flex !important;

    flex-direction: column !important;

    align-items: stretch !important;

    box-sizing: border-box !important;

}


/* ============================================================
   SATELLITE CENTER
   ============================================================ */

#satelliteCenter {

    width: 1400px !important;

    max-width: none !important;

    flex: 0 0 1400px !important;

    box-sizing: border-box !important;

}


/* ============================================================
   SATELLITE CARD VIEWPORT
   ============================================================ */

#satelliteGridViewport {

    width: 100% !important;

    max-width: none !important;

    overflow: hidden !important;

    box-sizing: border-box !important;

}


#satelliteGridViewport .satellite-grid {

    width: max-content !important;

    max-width: none !important;

    display: flex !important;

    flex-direction: row !important;

    flex-wrap: nowrap !important;

    gap: 24px !important;

    transform: none !important;

}


/*
    The global navigator moves the complete canvas.

    Therefore satellite cards themselves must NOT be
    translated independently.
*/

#satelliteGridViewport .satellite-card {

    transform: none !important;

}


/* ============================================================
   PRODUCT AREA
   ============================================================ */

#satelliteProductArea {

    width: 1400px !important;

    max-width: none !important;

    flex: 0 0 1400px !important;

    box-sizing: border-box !important;

}


#satelliteProductArea .sentinel2-product {

    width: 100% !important;

    max-width: none !important;

    box-sizing: border-box !important;

}


/* ============================================================
   GLOBAL BOTTOM NAVIGATOR
   ============================================================ */



















/* ============================================================
   MOBILE
   ============================================================ */

@media (max-width: 600px) {

    #satelliteCenter {

        width: 1100px !important;

        flex-basis: 1100px !important;

    }


    #satelliteProductArea {

        width: 1100px !important;

        flex-basis: 1100px !important;

    }


    


    

}


/* ============================================================
   END GLOBAL SATELLITE INTELLIGENCE CANVAS
   ============================================================ */


