/* ============================================================
   GeoShield Satellite Intelligence Center
   ============================================================ */

.satellite-center {
    margin-top: 24px;
    padding: 24px;
    border-radius: 16px;
    background: rgba(15, 23, 42, 0.96);
    border: 1px solid rgba(148, 163, 184, 0.18);
}

.satellite-center-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: 20px;
}

.satellite-center-header h2 {
    margin: 0 0 6px;
    font-size: 22px;
}

.satellite-center-header p {
    margin: 0;
    color: #94a3b8;
    line-height: 1.5;
}

.satellite-system-status {
    padding: 7px 12px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: 700;
    background: rgba(59, 130, 246, 0.12);
    color: #93c5fd;
    white-space: nowrap;
}

.satellite-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
}

.satellite-card {
    padding: 18px;
    border-radius: 14px;
    background: rgba(30, 41, 59, 0.8);
    border: 1px solid rgba(148, 163, 184, 0.15);
    transition:
        transform 0.2s ease,
        border-color 0.2s ease,
        box-shadow 0.2s ease;
}

.satellite-card:hover {
    transform: translateY(-2px);
    border-color: rgba(96, 165, 250, 0.45);
}

.satellite-card.active {
    border-color: rgba(34, 197, 94, 0.4);
}

.satellite-card.planned {
    opacity: 0.78;
}

.satellite-card-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
}

.satellite-icon {
    font-size: 30px;
    line-height: 1;
}

.satellite-name {
    margin: 8px 0 3px;
    font-size: 18px;
}

.satellite-provider {
    color: #94a3b8;
    font-size: 12px;
}

.satellite-status {
    padding: 5px 9px;
    border-radius: 999px;
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
}

.satellite-status.active {
    background: rgba(34, 197, 94, 0.12);
    color: #86efac;
}

.satellite-status.planned {
    background: rgba(245, 158, 11, 0.12);
    color: #fcd34d;
}

.satellite-category {
    margin-top: 14px;
    color: #cbd5e1;
    font-size: 13px;
    font-weight: 600;
}

.satellite-description {
    margin-top: 10px;
    color: #94a3b8;
    font-size: 13px;
    line-height: 1.5;
}

.satellite-capabilities {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
}

.satellite-capability {
    padding: 5px 8px;
    border-radius: 6px;
    background: rgba(51, 65, 85, 0.8);
    color: #cbd5e1;
    font-size: 10px;
}

.satellite-open-btn {
    width: 100%;
    margin-top: 16px;
    padding: 9px 12px;
    border: 0;
    border-radius: 8px;
    cursor: pointer;
    background: #2563eb;
    color: white;
    font-weight: 700;
    transition: background 0.2s ease;
}

.satellite-open-btn:hover {
    background: #1d4ed8;
}

.satellite-open-btn.planned {
    background: rgba(71, 85, 105, 0.8);
    cursor: default;
}

.satellite-loading {
    color: #94a3b8;
    padding: 20px;
}

.satellite-error {
    color: #fca5a5;
    padding: 20px;
    border-radius: 10px;
    background: rgba(127, 29, 29, 0.15);
    border: 1px solid rgba(248, 113, 113, 0.2);
}

@media (max-width: 700px) {

    .satellite-center {
        padding: 16px;
    }

    .satellite-center-header {
        flex-direction: column;
    }

    .satellite-system-status {
        align-self: flex-start;
    }

    .satellite-grid {
        grid-template-columns: 1fr;
    }
}
