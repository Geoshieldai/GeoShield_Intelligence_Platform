/* ============================================================
   GEOSHIELD WORKSPACE NAVIGATOR
   Right-side contextual page navigation
   ============================================================ */
#workspaceNavigator {
    position: fixed;
    right: 18px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2147483647;
    width: 50px;
    padding: 6px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    box-sizing: border-box;
    border-radius: 18px;
    background:
        rgba(31, 31, 31, 0.96);
    border:
        1px solid
        rgba(255, 255, 255, 0.10);
    box-shadow:
        0 8px 28px
        rgba(0, 0, 0, 0.35);
    backdrop-filter:
        blur(12px);
    -webkit-backdrop-filter:
        blur(12px);
    pointer-events:
        auto;
    user-select:
        none;
}
.workspace-nav-arrow {
    width: 38px;
    height: 38px;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    border: 0;
    border-radius: 50%;
    background:
        transparent;
    color:
        #d1d5db;
    font-family:
        Arial,
        Helvetica,
        sans-serif;
    font-size:
        23px;
    font-weight:
        700;
    line-height:
        1;
    cursor:
        pointer;
    pointer-events:
        auto;
    transition:
        background 0.18s ease,
        color 0.18s ease,
        transform 0.15s ease,
        opacity 0.18s ease;
}
.workspace-nav-arrow:hover:not(:disabled) {
    background:
        rgba(255, 255, 255, 0.10);
    color:
        #ffffff;
    transform:
        scale(1.08);
}
.workspace-nav-arrow:active:not(:disabled) {
    transform:
        scale(0.92);
}
.workspace-nav-arrow:disabled {
    opacity:
        0.25;
    cursor:
        default;
    transform:
        none;
}
.workspace-nav-arrow span {
    display:
        block;
    line-height:
        1;
}
.workspace-nav-divider {
    width:
        22px;
    height:
        1px;
    margin:
        1px 0;
    background:
        rgba(255, 255, 255, 0.12);
}
/*
 * ============================================================
 * ACTIVE WORKSPACE STATES
 * ============================================================
 */
#workspaceNavigator[data-workspace="map"]
.workspace-nav-arrow:first-child {
    color:
        #ffffff;
}
#workspaceNavigator[data-workspace="intelligence"]
.workspace-nav-arrow:last-child {
    color:
        #ffffff;
}
/*
 * ============================================================
 * MOBILE
 * ============================================================
 */
@media (max-width: 700px) {
    #workspaceNavigator {
        right:
            10px;
        width:
            46px;
        padding:
            5px;
        border-radius:
            16px;
    }
    .workspace-nav-arrow {
        width:
            36px;
        height:
            36px;
        font-size:
            21px;
    }
}
/*
 * ============================================================
 * VERY SMALL SCREENS
 * ============================================================
 */
@media (max-width: 450px) {
    #workspaceNavigator {
        right:
            7px;
    }
    .workspace-nav-arrow {
        width:
            34px;
        height:
            34px;
        font-size:
            20px;
    }
}
/* ============================================================
   GEOSHIELD OS — CANONICAL WORKSPACE LAYOUT
   MAP → INTELLIGENCE
   ============================================================ */

html {
    scroll-behavior: smooth;
}

body {
    overflow-x: hidden;
}

/* ------------------------------------------------------------
   WORKSPACE PAGES
   Both pages remain in the document.
   They are NOT display:none.
   ------------------------------------------------------------ */

.geoshield-workspace-page {
    position: relative;
    width: 100%;
    box-sizing: border-box;
}

#geoshieldMapPage {
    min-height: calc(100vh - 80px);
    padding-bottom: 24px;
}

#geoshieldIntelligencePage {
    min-height: 100vh;
    padding-bottom: 80px;
}

/* ------------------------------------------------------------
   MAIN MAP WORKSPACE
   ------------------------------------------------------------ */

#geoshieldMapPage .workspace {
    width: 100%;
    box-sizing: border-box;

    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 18px;

    align-items: stretch;
}

/* ------------------------------------------------------------
   MAP
   ------------------------------------------------------------ */

#geoshieldMapPage .map-section {
    min-width: 0;
    width: 100%;
    height: 560px;

    position: relative;
    overflow: hidden;

    border-radius: 16px;
}

#geoshieldMapPage #map {
    width: 100%;
    height: 100%;
}

/* ------------------------------------------------------------
   RIGHT INFORMATION PANEL
   ------------------------------------------------------------ */

#geoshieldMapPage .info-panel {
    min-width: 0;

    display: flex;
    flex-direction: column;
    gap: 12px;

    height: 560px;
    overflow-y: auto;

    box-sizing: border-box;
}

/* ------------------------------------------------------------
   INFORMATION CARDS
   ------------------------------------------------------------ */

#geoshieldMapPage .info-panel .panel-card {
    flex: 1 1 auto;
    min-height: 0;

    box-sizing: border-box;
}

/* ------------------------------------------------------------
   BOTTOM METRICS
   ------------------------------------------------------------ */

#geoshieldMapPage .bottom-dashboard {
    width: 100%;

    display: grid;
    grid-template-columns:
        repeat(6, minmax(0, 1fr));

    gap: 12px;

    margin-top: 18px;
}

#geoshieldMapPage .bottom-card {
    min-width: 0;
    box-sizing: border-box;
}

/* ------------------------------------------------------------
   SATELLITE INTELLIGENCE
   ------------------------------------------------------------ */

#geoshieldIntelligencePage {
    width: 100%;
    box-sizing: border-box;
}

#geoshieldIntelligencePage .satellite-center {
    width: 100%;
    max-width: none;
    box-sizing: border-box;
}

/* ------------------------------------------------------------
   SATELLITE GRID
   Horizontal card rail.
   Vertical page scrolling is NOT used for the cards.
   ------------------------------------------------------------ */

#geoshieldIntelligencePage .satellite-grid {
    width: 100%;
    min-width: 0;

    display: flex;
    flex-wrap: nowrap;
    gap: 20px;

    overflow-x: auto;
    overflow-y: hidden;

    scroll-behavior: smooth;

    padding: 8px 4px 18px;

    box-sizing: border-box;

    scrollbar-width: thin;
}

/* ------------------------------------------------------------
   SATELLITE CARDS
   ------------------------------------------------------------ */

#geoshieldIntelligencePage .satellite-grid > * {
    flex: 0 0 310px;
    width: 310px;
    min-width: 310px;

    box-sizing: border-box;
}

/* ------------------------------------------------------------
   SENTINEL-2 PRODUCT
   ------------------------------------------------------------ */

#geoshieldIntelligencePage .sentinel2-product {
    width: 100%;
    max-width: none;

