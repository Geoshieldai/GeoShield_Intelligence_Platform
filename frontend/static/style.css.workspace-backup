/* ============================================================
   GEOSHIELD OS — CANONICAL WORKSPACE / SATELLITE CSS
   ============================================================ */

/* ------------------------------------------------------------
   ROOT
   ------------------------------------------------------------ */

html,
body {
    width: 100%;
    min-width: 0;
    min-height: 100%;
    margin: 0;
    padding: 0;
}


/* ------------------------------------------------------------
   APPLICATION SHELL
   ------------------------------------------------------------ */

.app-shell,
#app,
.app {
    width: 100%;
    min-width: 0;
    min-height: 100vh;
    box-sizing: border-box;
}


/* ------------------------------------------------------------
   MAIN MAP WORKSPACE
   ------------------------------------------------------------ */

.workspace {
    position: relative !important;
    display: grid !important;
    grid-template-columns: minmax(0, 1fr) 280px !important;
    grid-template-rows: minmax(0, 1fr) !important;
    width: 100% !important;
    height: 100% !important;
    min-width: 0 !important;
    min-height: 0 !important;
    box-sizing: border-box !important;
    overflow: hidden !important;
}


/* ------------------------------------------------------------
   MAP
   ------------------------------------------------------------ */

.workspace .map-section {
    position: relative !important;
    grid-column: 1 !important;
    grid-row: 1 !important;
    width: 100% !important;
    height: 100% !important;
    min-width: 0 !important;
    min-height: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow: hidden !important;
}

.workspace #map {
    position: relative !important;
    width: 100% !important;
    height: 100% !important;
    min-width: 0 !important;
    min-height: 0 !important;
    margin: 0 !important;
    padding: 0 !important;
    overflow: hidden !important;
    z-index: 1 !important;
}

.workspace #map .leaflet-container {
    width: 100% !important;
    height: 100% !important;
}


/* ------------------------------------------------------------
   RIGHT INFORMATION PANEL
   ------------------------------------------------------------ */

.workspace .info-panel {
    grid-column: 2 !important;
    grid-row: 1 !important;
    min-width: 280px !important;
    width: 280px !important;
    height: 100% !important;
    min-height: 0 !important;
    box-sizing: border-box !important;
    overflow-x: hidden !important;
    overflow-y: auto !important;
}


/* ============================================================
   SATELLITE INTELLIGENCE PAGE
   ============================================================ */

#geoshieldIntelligencePage {
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
}


/* ------------------------------------------------------------
   SATELLITE CENTER
   ------------------------------------------------------------ */

#satelliteCenter {
    position: relative !important;
    width: 100% !important;
    min-width: 0 !important;
    min-height: 420px !important;
    box-sizing: border-box !important;
    overflow-x: hidden !important;
}


/* ------------------------------------------------------------
   SATELLITE CARD VIEWPORT
   ------------------------------------------------------------ */

#satelliteCenter #satelliteGridViewport {
    width: 100% !important;
    max-width: 1400px !important;
    margin: 0 auto !important;
    padding: 0 !important;

    overflow-x: auto !important;
    overflow-y: hidden !important;

    box-sizing: border-box !important;

    scrollbar-width: none !important;
    -ms-overflow-style: none !important;
}

#satelliteCenter #satelliteGridViewport::-webkit-scrollbar {
    display: none !important;
}


/* ------------------------------------------------------------
   SATELLITE CARD TRACK
   ------------------------------------------------------------ */

#satelliteCenter #satelliteGrid {
    display: flex !important;
    flex-direction: row !important;
    flex-wrap: nowrap !important;

    width: max-content !important;
    min-width: 100% !important;
    max-width: none !important;

    margin: 0 !important;
    padding: 0 !important;

    gap: 18px !important;

    align-items: stretch !important;
    justify-content: flex-start !important;

    transform: none !important;
    transition: none !important;
}


/* ------------------------------------------------------------
   SATELLITE CARDS
   ------------------------------------------------------------ */

#satelliteCenter #satelliteGrid > .satellite-card {
    flex: 0 0 300px !important;

    width: 300px !important;
    min-width: 300px !important;
    max-width: 300px !important;

    box-sizing: border-box !important;

    transform: none;
}


/* ------------------------------------------------------------
   SATELLITE HORIZONTAL NAVIGATOR
   ------------------------------------------------------------ */

#satelliteCenter #satelliteHorizontalNavigator {
    width: 100% !important;
    max-width: 1400px !important;

    min-height: 44px !important;

    margin: 14px auto 0 auto !important;
    padding: 0 !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    gap: 14px !important;

    box-sizing: border-box !important;

    position: relative !important;
    z-index: 10 !important;
}


/* ------------------------------------------------------------
   HORIZONTAL NAVIGATION BUTTONS
   ------------------------------------------------------------ */

#satelliteCenter #satelliteHorizontalNavigator
.satellite-horizontal-nav-button {
    flex: 0 0 38px !important;

    width: 38px !important;
    height: 34px !important;
    min-width: 38px !important;
    min-height: 34px !important;

    margin: 0 !important;
    padding: 0 !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    box-sizing: border-box !important;

    border-radius: 50% !important;

    cursor: pointer !important;
}


/* ------------------------------------------------------------
   NAVIGATION LINE
   ------------------------------------------------------------ */

#satelliteCenter #satelliteHorizontalNavigator
.satellite-horizontal-nav-line {
    flex: 0 1 900px !important;

    width: min(900px, 55vw) !important;
    max-width: 900px !important;

    height: 1px !important;

    box-sizing: border-box !important;
}


/* ------------------------------------------------------------
   SENTINEL-2 PRODUCT
   ------------------------------------------------------------ */

#sentinel2Product {
    width: 100% !important;
    min-width: 0 !important;

    min-height: 520px !important;

    margin-top: 24px !important;
    margin-bottom: 40px !important;

    box-sizing: border-box !important;
}


/* ------------------------------------------------------------
   WORKSPACE NAVIGATOR
   ------------------------------------------------------------ */

#workspaceNavigator {
    position: fixed !important;

    right: 12px !important;
    top: 50% !important;
    left: auto !important;
    bottom: auto !important;

    transform: translateY(-50%) !important;

    z-index: 2147483647 !important;

    pointer-events: auto !important;
}


/* ------------------------------------------------------------
   NO WORKSPACE TRANSITIONS
   ------------------------------------------------------------ */

.workspace,
.satellite-data-center,
.satellite-center,
.sentinel2-product,
.bottom-dashboard {
    transition: none !important;
    animation: none !important;
}


/* ============================================================
   RESPONSIVE
   ============================================================ */

@media (max-width: 900px) {

    #satelliteCenter #satelliteGrid > .satellite-card {
        flex-basis: 280px !important;
        width: 280px !important;
        min-width: 280px !important;
        max-width: 280px !important;
    }

    #satelliteCenter #satelliteHorizontalNavigator
    .satellite-horizontal-nav-line {
        width: 45vw !important;
        max-width: 600px !important;
    }

    #workspaceNavigator {
        right: 7px !important;
    }
}


@media (max-width: 600px) {

    #satelliteCenter #satelliteGrid > .satellite-card {
        flex-basis: 260px !important;
        width: 260px !important;
        min-width: 260px !important;
        max-width: 260px !important;
    }

    #satelliteCenter #satelliteHorizontalNavigator {
        gap: 10px !important;
    }

    #satelliteCenter #satelliteHorizontalNavigator
    .satellite-horizontal-nav-button {
        flex-basis: 34px !important;
        width: 34px !important;
        height: 32px !important;
        min-width: 34px !important;
    }

    #satelliteCenter #satelliteHorizontalNavigator
    .satellite-horizontal-nav-line {
        width: 35vw !important;
        max-width: 180px !important;
    }
}


/* ============================================================
   END CANONICAL SATELLITE / WORKSPACE CSS
   ============================================================ */

/* ============================================================
   GEOSHIELD WORKSPACE PAGE ISOLATION — FINAL
   Only ONE workspace page exists visually at a time.
   ============================================================ */

#geoshieldMapPage,
#geoshieldIntelligencePage {
    width: 100%;
    box-sizing: border-box;
}

#geoshieldMapPage[hidden],
#geoshieldIntelligencePage[hidden] {
    display: none !important;
}

body.geoshield-map-mode #geoshieldMapPage {
    display: block !important;
}

body.geoshield-map-mode #geoshieldIntelligencePage {
    display: none !important;
}

body.geoshield-intelligence-mode #geoshieldMapPage {
    display: none !important;
}

body.geoshield-intelligence-mode #geoshieldIntelligencePage {
    display: block !important;
}

/* Prevent the two workspace pages from becoming one long document */
html,
body {
    overflow: hidden !important;
}

.geoshield-workspace-page {
    width: 100%;
    height: 100vh;
    min-height: 100vh;
    box-sizing: border-box;
    overflow: hidden;
}

.geoshield-map-page {
    height: 100vh;
    min-height: 100vh;
}

.geoshield-intelligence-page {
    height: 100vh;
    min-height: 100vh;
    overflow-y: auto;
    overflow-x: hidden;
}

/* Workspace switcher stays outside both pages */
#workspaceNavigator {
    position: fixed !important;
    z-index: 999999 !important;
}


/* ============================================================
   GEOSHIELD TWO-STATE WORKSPACE — DEFINITIVE ISOLATION
   ============================================================ */

html,
body {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden !important;
}

.geoshield-workspace-page {
    width: 100%;
    height: 100%;
    min-width: 0;
    min-height: 0;
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

#geoshieldMapPage,
#geoshieldIntelligencePage {
    display: none !important;
}

body.geoshield-map-mode #geoshieldMapPage {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    overflow: hidden !important;
}

body.geoshield-intelligence-mode #geoshieldIntelligencePage {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    overflow-x: hidden !important;
    overflow-y: auto !important;
}

#geoshieldMapPage.workspace-page-active {
    display: block !important;
}

#geoshieldIntelligencePage.workspace-page-active {
    display: block !important;
}

/* Main map workspace must occupy the complete active page */
body.geoshield-map-mode .workspace {
    width: 100% !important;
    height: 100% !important;
    min-height: 0 !important;
    overflow: hidden !important;
}

/* Intelligence page owns its own scrolling */
body.geoshield-intelligence-mode #satelliteCenter {
    width: 100% !important;
    min-height: 100% !important;
    box-sizing: border-box !important;
}

/* Workspace navigator is outside both pages */
#workspaceNavigator {
    position: fixed !important;
    z-index: 999999 !important;
}

/* ============================================================
   END TWO-STATE WORKSPACE
   ============================================================

/* ============================================================
   GEOSHIELD TWO-STATE WORKSPACE — SINGLE CANONICAL SYSTEM
   ============================================================ */

html,
body {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden !important;
}

.geoshield-workspace-page {
    position: fixed !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100vh !important;
    min-height: 100vh !important;
    margin: 0 !important;
    padding: 0 !important;
    box-sizing: border-box !important;
    visibility: hidden !important;
    opacity: 0 !important;
    pointer-events: none !important;
    z-index: 0 !important;
}

#geoshieldMapPage,
#geoshieldIntelligencePage {
    display: none !important;
}

body.geoshield-map-mode #geoshieldMapPage,
body.geoshield-intelligence-mode #geoshieldIntelligencePage {
    display: block !important;
}

body.geoshield-map-mode #geoshieldMapPage,
body.geoshield-intelligence-mode #geoshieldIntelligencePage {
    visibility: visible !important;
    opacity: 1 !important;
    pointer-events: auto !important;
    z-index: 1 !important;
}

body.geoshield-map-mode #geoshieldIntelligencePage,
body.geoshield-intelligence-mode #geoshieldMapPage {
    visibility: hidden !important;
    opacity: 0 !important;
    pointer-events: none !important;
    z-index: 0 !important;
}

body.geoshield-map-mode .workspace {
    width: 100% !important;
    height: 100% !important;
    min-height: 0 !important;
    overflow: hidden !important;
}

body.geoshield-intelligence-mode #geoshieldIntelligencePage {
    overflow-x: hidden !important;
    overflow-y: auto !important;
}

body.geoshield-intelligence-mode #satelliteCenter {
    width: 100% !important;
    min-height: 100% !important;
    box-sizing: border-box !important;
}

#workspaceNavigator {
    position: fixed !important;
    right: 18px !important;
    bottom: 18px !important;
    z-index: 999999 !important;
}

